# Only the API URL reaches the browser; vite.config.ts picks it by name.
# Either set this, or let `neon deploy` write NEON_FUNCTION_WATER_BASE_URL.
WATER_API_URL=http://localhost:8787

# For `npm run dev:api` against a local PostGIS (see CLAUDE.md).
DATABASE_URL=postgres://postgres@127.0.0.1:5433/water
